PORT=5000
FIREBASE_DATABASE_URL=https://uni-med-care-default-rtdb.firebaseio.com
# Paste your service account JSON as one line for local backend auth:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
ADMIN_EMAIL=admin@unimedcare.com
# Generate with bcryptjs and store the hash here, not the plain password.
# ADMIN_PASSWORD_HASH=$2b$12$...
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
